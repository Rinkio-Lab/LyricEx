coverage/
.nyc_output/
test-results/
playwright-report/
.pw-browsers/

# --- build output (if a bundler/build step is ever added) ---
dist/
build/
out/
.vite/
.cache/

# --- logs & debug ---
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.eslintcache

# --- editor / IDE (local only) ---
.vscode/
.idea/
*.suo
*.ntvs*
